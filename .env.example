# Copy to .env.local and fill in the Firebase Console web app configuration.
# On Netlify, set the same VITE_FIREBASE_* variables before building.
# VITE_* values are bundled into the browser app; use Firebase web config only.
# Never put an OpenAI key or a Firebase service-account private key here.

# Required for Google sign-in
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional web app configuration
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Authentication UIDs, separated by commas (case-sensitive).
# Example: VITE_ADMIN_UIDS=first_admin_uid,second_admin_uid
# Empty means no administrators. Restart Vite / rebuild Netlify after changes.
# This controls frontend navigation; Firebase data permissions use Security Rules.
VITE_ADMIN_UIDS=
